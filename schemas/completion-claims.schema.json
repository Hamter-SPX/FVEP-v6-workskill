{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/completion-claims-and-evidence.json",
  "title": "Completion Claims and Evidence",
  "description": "Typed completion claims bound to current, passing, scoped evidence and artifact identity.",
  "type": "object",
  "required": [
    "claims",
    "evidence"
  ],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "artifactHash",
          "evidenceIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "tests-pass",
              "build-passes",
              "visual-match",
              "security-gates-pass",
              "production-ready",
              "bug-fixed"
            ]
          },
          "artifactHash": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "generatedAt",
          "artifactHash",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "artifactHash": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "exitStatus": {
            "type": "integer"
          },
          "failures": {
            "type": "integer",
            "minimum": 0
          },
          "hardFailures": {
            "type": "integer",
            "minimum": 0
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
