{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture Contract",
  "type": "object",
  "required": [
    "components",
    "edges"
  ],
  "properties": {
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "owner",
          "criticality",
          "trustZone"
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "protocol"
        ]
      }
    }
  }
}
