{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontend-vision-loop.local/schemas/aesthetic-profile-v1.json",
  "title": "Aesthetic Profile",
  "description": "Declared visual character for a product surface. Every entry must be checkable against a rendered artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["product", "personality", "noveltyBudget", "systems"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "type": "string", "minLength": 1 },
    "audience": { "type": "string" },
    "rationale": { "type": "string" },
    "personality": {
      "type": "object",
      "description": "Positions on each axis from 1 to 5. The low end of each axis is 1.",
      "additionalProperties": false,
      "required": ["seriousPlayful", "warmClinical", "understatedExpressive", "denseSpacious", "establishedNovel"],
      "properties": {
        "seriousPlayful": { "$ref": "#/$defs/axis" },
        "warmClinical": { "$ref": "#/$defs/axis" },
        "understatedExpressive": { "$ref": "#/$defs/axis" },
        "denseSpacious": { "$ref": "#/$defs/axis" },
        "establishedNovel": { "$ref": "#/$defs/axis" }
      }
    },
    "styleDirection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "archetype": {
          "enum": [
            "swiss",
            "editorial",
            "neo-minimal",
            "utilitarian",
            "brutalist",
            "soft-rounded",
            "glass-layered",
            "bento",
            "retro-digital",
            "none"
          ]
        },
        "adopted": { "type": "array", "items": { "type": "string" } },
        "rejected": { "type": "array", "items": { "type": "string" } }
      }
    },
    "noveltyBudget": {
      "type": "array",
      "minItems": 1,
      "description": "Each entry names one position where distinctiveness is deliberately spent.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["position", "decision"],
        "properties": {
          "position": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "minLength": 1 },
          "reason": { "type": "string" }
        }
      }
    },
    "systems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "typography", "spacing"],
      "properties": {
        "color": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "neutralTemperature": { "enum": ["warm", "neutral", "cool"] },
            "neutralSteps": { "type": "integer", "minimum": 2, "maximum": 20 },
            "accentCount": { "type": "integer", "minimum": 0, "maximum": 4 },
            "harmony": { "enum": ["monochromatic", "analogous", "complementary", "split-complementary", "triadic", "unconstrained"] },
            "themes": { "type": "array", "items": { "enum": ["light", "dark", "high-contrast"] } }
          }
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scaleRatio": { "type": "number", "minimum": 1.02, "maximum": 2 },
            "roleCount": { "type": "integer", "minimum": 2, "maximum": 12 },
            "families": { "type": "array", "items": { "type": "string" } },
            "maxMeasureCharacters": { "type": "number", "minimum": 20, "maximum": 160 }
          }
        },
        "spacing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseUnitPx": { "type": "number", "exclusiveMinimum": 0 },
            "scale": { "type": "array", "items": { "type": "number", "minimum": 0 } },
            "density": { "enum": ["dense", "comfortable", "spacious"] }
          }
        },
        "shape": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "radiiPx": { "type": "array", "items": { "type": "number", "minimum": 0 } },
            "elevationLevels": { "type": "integer", "minimum": 0, "maximum": 8 }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "durationsMs": { "type": "array", "items": { "type": "number", "minimum": 0 } },
            "easings": { "type": "array", "items": { "type": "string" } },
            "overshoot": { "enum": ["none", "subtle", "pronounced"] },
            "reducedMotionSupported": { "type": "boolean" }
          }
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "person": { "$ref": "#/$defs/axis" },
        "register": { "$ref": "#/$defs/axis" },
        "density": { "$ref": "#/$defs/axis" },
        "certainty": { "$ref": "#/$defs/axis" },
        "humour": { "$ref": "#/$defs/axis" }
      }
    },
    "nonGoals": { "type": "array", "items": { "type": "string" } },
    "references": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "integer", "minimum": 1, "maximum": 5 },
        "reason": { "type": "string" },
        "consequences": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
