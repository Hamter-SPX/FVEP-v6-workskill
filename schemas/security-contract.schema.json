{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Security Contract",
  "type": "object",
  "required": [
    "controls"
  ],
  "properties": {
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "implemented",
                  "partial",
                  "missing",
                  "not-applicable"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    }
  }
}
