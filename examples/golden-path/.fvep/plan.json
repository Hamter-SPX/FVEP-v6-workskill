        },
        {
          "kind": "verify-green",
          "command": "node --test test/slug.test.mjs",
          "expected": "PASS: 5 of 5 tests green"
        },
        {
          "kind": "commit",
          "command": "git commit -m \"feat: add slugify helper with TDD evidence\"",
          "expected": "One focused commit on feature/slugify-helper"
        }
      ]
    }
  ]
